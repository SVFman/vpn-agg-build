+def _src_ts_to_utc(value):
+    """src_ts -> UTC в формате журнала TS_FMT (правка 9.1, T-06).
+
+    extract_source_ts возвращает метку в зоне источника (обычно +03:00);
+    журнал хранит все времена в UTC, поэтому src_ts при записи в журнал
+    приводится к «...Z». Пустое остаётся пустым; нечитаемое и метка без
+    зоны пишутся как есть: зона не угадывается (как в extract_source_ts),
+    а мусор сюда попадает только из старых журналов и прямых вызовов.
+    """
+    if not value:
+        return ""
+    v = value.strip()
+    if v.endswith("Z"):
+        return v
+    try:
+        dt = datetime.datetime.fromisoformat(v)
+    except ValueError:
+        return v
+    if dt.tzinfo is None:
+        return v
+    return dt.astimezone(datetime.timezone.utc).strftime(TS_FMT)
+
